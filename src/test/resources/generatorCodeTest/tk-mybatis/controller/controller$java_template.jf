package #(packageName);

import com.github.pagehelper.PageInfo;

import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import lombok.extern.slf4j.Slf4j;
import org.springframework.util.ObjectUtils;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

import javax.annotation.Resource;

/**
 * 控制器 #(tableMetaExtend.remarks)
 * @author dev
 */
@Slf4j
@RestController
@RequestMapping("/customization/xx/#(entityObjectName)")
@Api(tags = "")
public class #(className) {
  
    @Resource
    private #(entityName)Service #(entityObjectName)Service;

    @RequestMapping(value = "/header" , method = RequestMethod.POST)
    @ApiOperation(value = "汇总",notes = "汇总")
    public BaseResponse<?> queryHeader(@RequestBody #(entityName)Param.Query request) throws Exception{
        if(ObjectUtils.isEmpty(request.getMonth())) {
            return new BaseResponse<>(ErrorType.SUCCESS_200, "时间信息不能为空");
        }
        return new BaseResponse<>(ErrorType.SUCCESS_200, #(entityObjectName)Service.queryHeader(request));
    }

    @RequestMapping(value = "/list" , method = RequestMethod.POST)
    @ApiOperation(value =  "分页列表", notes =  "分页列表")
    public BaseResponse<#(entityName)Param.RecordDTO> queryPage(@RequestBody #(entityName)Param.Query request) {
        PageInfo<#(entityName)Param.RecordDTO> responseDataPage = #(entityObjectName)Service.queryPage(request);
        return  ResponseDataPage.buildSuccess(responseDataPage);
    }

    @RequestMapping(value = "/add", method = RequestMethod.POST)
    @ApiOperation(value = "添加记录", notes = "添加记录")
    public BaseResponse<?> saveAdd(@RequestBody @Valid #(entityName)Param.CreateParam param) {
        try {
            if(Helper.isEmpty(param.getOperatorId()) ) {
                return new BaseResponse<>(ErrorType.FAILED.getCode(), "请指定操作员", null);
            }
            return new BaseResponse<>(ErrorType.SUCCESS, #(entityObjectName)Service.saveAdd(param));
        } catch (Exception e) {
            log.error("", e);
            return new BaseResponse<>(ErrorType.FAILED.getCode(), e.getMessage(), null);
        }
    }

    @RequestMapping(value = "/update", method = RequestMethod.POST)
    @ApiOperation(value = "变更记录", notes = "变更记录")
    public BaseResponse<?> update(@RequestBody @Valid #(entityName)Param.UpdateParam param) {
        try {
            if(Helper.isEmpty(param.getOperatorId()) ) {
                return new BaseResponse<>(ErrorType.FAILED.getCode(), "请指定操作员", null);
            }
            return new BaseResponse<>(ErrorType.SUCCESS, #(entityObjectName)Service.update(param));
        } catch (Exception e) {
            log.error("", e);
            return new BaseResponse<>(ErrorType.FAILED.getCode(), e.getMessage(), null);
        }
    }

    @RequestMapping(value = "/delete", method = RequestMethod.POST)
    @ApiOperation(value = "删除记录", notes = "删除记录")
    public BaseResponse<?> delete(@RequestBody @Valid #(entityName)Param.DeleteParam param) {
        try {
            if(Helper.isEmpty(param.getOperatorId()) ) {
                return new BaseResponse<>(ErrorType.FAILED.getCode(), "请指定操作员", null);
            }
            return new BaseResponse<>(ErrorType.SUCCESS, #(entityObjectName)Service.delete(param));
        } catch (Exception e) {
            log.error("", e);
            return new BaseResponse<>(ErrorType.FAILED.getCode(), e.getMessage(), null);
        }
    }

 
    @RequestMapping(value = "/export" , method = RequestMethod.GET)
    @ApiOperation(value = "导出记录",notes = "导出记录")
    public void exportData(HttpServletResponse response, #(entityName)Param.Query request) throws Exception {
        long t1 = System.currentTimeMillis();
        request.setPage(1);
        request.setLimit(Integer.MAX_VALUE);

        List<#(entityName)Excel.Record> records = 
                BeanUtil.copyToList(#(entityObjectName)Service.queryPage(request).getList() ,#(entityName)Excel.Record.class);

        #(entityName)Excel.Header header = 
                BeanUtil.copyProperties(#(entityObjectName)Service.queryHeader(request), #(entityName)Excel.Header.class);
                
        CommonExcelUtil.writeExcel(response,
                // 主记录
                records, #(entityName)Excel.Record.class,
                // 汇总记录
                CollUtil.toList(header), #(entityName)Excel.Header.class
        );
        
        long t2 = System.currentTimeMillis();
        log.info(String.format("write over! cost:%sms", (t2 - t1)));
    }

    @RequestMapping(value = "/import", method = RequestMethod.POST ,produces = {MediaType.APPLICATION_JSON_UTF8_VALUE})
    @ApiOperation(value = "导入记录", notes = "模板地址：/excel/xxxx导入模板.xlsx")
    public BaseResponse<?> importData(@RequestParam(value="file", required = false) MultipartFile file) {
        try {
            List<#(entityName)Excel.Record> importList = CommonExcelUtil.readExcel("", #(entityName)Excel.Record.class, file);
            
            //转换 时间, 状态字段
            List<#(entityName)Param.CreateParam> list = BeanUtil.copyToList(importList, #(entityName)Param.CreateParam.class);
    
            #(entityObjectName)Service.saveAddList(list);
            
            return new BaseResponse<>(ErrorType.SUCCESS, null);
        } catch (Exception e) {
            return new BaseResponse<>(ErrorType.FAILED, e.getMessage());
        }
    }

}

