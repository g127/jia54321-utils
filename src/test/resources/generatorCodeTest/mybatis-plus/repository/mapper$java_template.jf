package #(packageName);

import com.baomidou.mybatisplus.core.mapper.BaseMapper;
import #(basePackageName).param.#(entityName)Param;
import #(basePackageName).entity.#(entityName);

import java.util.List;

/**
 * Mapper类 #(tableMetaExtend.remarks)
 * @author dev
 */
public interface #(className) extends BaseMapper<#(entityName)> {
    /**
     * 汇总小计
     * @param query 查询条件
     * @return 结果
     */
    #(entityName)Param.CountDTO queryHeader(#(entityName)Param.Query query);

    /**
     * 查询列表
     * @param query 查询条件
     * @return 结果
     */
    List<#(entityName)Param.RecordDTO> queryList(#(entityName)Param.Query query);
}

